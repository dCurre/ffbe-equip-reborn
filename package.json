{
  "name": "ffbe-equip-reborn",
  "version": "1.0.0",
  "description": "FFBE Equip Reborn",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/static/*.js\"",
    "test:coverage": "node test/coverage.mjs",
    "test:golden:update": "node test/static/golden/update.mjs",
    "build:units": "node tools/generateUnitFiles.js",
    "start": "node tools/generateUnitFiles.js && npx --yes serve static -l 3000 -c ../serve.json"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dCurre/ffbe-equip-reborn.git"
  },
  "author": "dCurre (https://github.com/dCurre)",
  "contributors": [
    "Lyrgard (creator of FFBE Equip, https://github.com/lyrgard/ffbeEquip)",
    "Ben Sailors (FFBE Equip Next, https://github.com/sailorsben/ffbeEquip)"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dCurre/ffbe-equip-reborn/issues"
  },
  "homepage": "https://dcurre.github.io/ffbe-equip-reborn/",
  "dependencies": {
    "pngjs": "6.0.0",
    "unorm": "^1.6.0"
  },
  "devDependencies": {
    "image-size": "^1.0.2"
  }
}
