{
  "name": "ffbe-equip-reborn",
  "version": "1.0.0",
  "description": "FFBE Equip Reborn",
  "main": "server.js",
  "engines": {
    "node": ">=15"
  },
  "scripts": {
    "profileTest": "node --inspect server.js",
    "test": "nyc mocha test/server --recursive",
    "test:web": "mocha-webpack --webpack-config test/webpack.config.js --require test/setup.js test/static/*.js",
    "build:units": "node tools/generateUnitFiles.js",
    "prestart": "node config.js && node tools/generateUnitFiles.js",
    "start": "node server.js"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dCurre/ffbe-equip-reborn.git"
  },
  "author": "dCurre (https://github.com/dCurre)",
  "contributors": [
    "Lyrgard (creator of FFBE Equip, https://github.com/lyrgard/ffbeEquip)",
    "Ben Sailors (FFBE Equip Next, https://github.com/sailorsben/ffbeEquip)"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dCurre/ffbe-equip-reborn/issues"
  },
  "homepage": "https://dcurre.github.io/ffbe-equip-reborn/",
  "dependencies": {
    "@hapi/boom": "^10.0.0",
    "@sindresorhus/is": "5.3.0",
    "bluebird": "3.7.2",
    "body-parser": "^1.20.0",
    "client-sessions": "0.8.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "es-main": "^1.2.0",
    "express": "^4.18.1",
    "firebase-admin": "^11.0.1",
    "googleapis": "105.0.0",
    "helmet": "^5.1.1",
    "joi": "17.6.0",
    "pngjs": "6.0.0",
    "request": "^2.87.0",
    "unorm": "^1.6.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "image-size": "^1.0.2",
    "mocha": "10.0.0",
    "mock-require": "3.0.3",
    "nock": "13.2.9",
    "nyc": "15.1.0",
    "supertest": "6.2.4",
    "webpack-node-externals": "3.0.0"
  },
  "nyc": {
    "all": true,
    "include": [
      "server/**/*.js"
    ]
  }
}
